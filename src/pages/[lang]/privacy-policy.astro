---
import StaticContentPage from "@/components/layout/StaticContentPage.astro"
import type { Locale } from "@/config/locales"
import { getPageStaticPaths } from "@/utils/content"
import { t } from "@/utils/translations"

export const getStaticPaths = () => getPageStaticPaths("privacy-policy")

const { lang } = Astro.props as { lang: Locale }
---

<StaticContentPage lang={lang} slug="privacy-policy" fallbackTitle={t(lang, "footer.privacyPolicy")} />
