---
import StaticContentPage from "@/components/layout/StaticContentPage.astro"
import type { Locale } from "@/config/locales"
import { getPageStaticPaths } from "@/utils/content"
import { t } from "@/utils/translations"

export const getStaticPaths = () => getPageStaticPaths("contact")

const { lang } = Astro.props as { lang: Locale }
---

<StaticContentPage lang={lang} slug="contact" fallbackTitle={t(lang, "footer.contactUs")} />
