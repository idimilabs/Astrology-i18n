---
import StaticContentPage from "@/components/layout/StaticContentPage.astro"
import type { Locale } from "@/config/locales"
import { getPageStaticPaths } from "@/utils/content"
import { t } from "@/utils/translations"

export const getStaticPaths = () => getPageStaticPaths("terms-of-service")

const { lang } = Astro.props as { lang: Locale }
---

<StaticContentPage lang={lang} slug="terms-of-service" fallbackTitle={t(lang, "footer.termsOfService")} />
